{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/application/**/*.ts", "src/infrastructure/**/*.ts", "src/presentation/**/*.d.ts", "scripts/**/*.ts", "tests/**/*.ts", "playwright*.config.ts"]
}
