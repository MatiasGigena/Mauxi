{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/application/**/*.ts", "src/infrastructure/**/*.ts", "scripts/**/*.ts", "tests/unit/**/*.ts", "tests/e2e/**/*.ts", "playwright.config.ts"]
}
