{
  "name": "mauxi-g0-proof",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": ["fixtures/*"],
  "scripts": {
    "build": "vite build && npm run build:host",
    "build:host": "esbuild src/infrastructure/electron/main.ts --bundle --platform=node --format=esm --external:electron --outfile=dist-electron/main.js && esbuild src/infrastructure/electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "dev": "npm run build:host && concurrently -k -s first \"vite --host 127.0.0.1 --port 44173\" \"wait-on http://127.0.0.1:44173 && cross-env MAUXI_RENDERER_URL=http://127.0.0.1:44173 electron dist-electron/main.js\"",
    "instrument:apply": "tsx scripts/instrument.ts apply",
    "instrument:clean": "tsx scripts/instrument.ts clean",
    "instrument:recover": "tsx scripts/instrument.ts recover",
    "fixtures:dev": "concurrently -k -s first \"npm run dev -w @mauxi-fixture/vite\" \"npm run dev -w @mauxi-fixture/next\"",
    "fixtures:build": "npm run build -w @mauxi-fixture/vite && npm run build -w @mauxi-fixture/next",
    "verify:production": "npm run fixtures:build && tsx scripts/verify-production.ts",
    "test": "vitest run tests/unit",
    "test:e2e": "bash scripts/e2e.sh",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-grab": "0.2.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "44.4.1",
    "esbuild": "0.28.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wait-on": "9.0.4"
  }
}
